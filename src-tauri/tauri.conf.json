{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Niko Buddy",
  "version": "2.4.3",
  "identifier": "com.niko-buddy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Niko Buddy",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http:; img-src 'self' asset: https://asset.localhost; media-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; worker-src 'self' blob: data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../skills/**/*": "skills/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyNDM3RjFDMjcyN0IxRjEKUldUeHNTY25ISDlETWxOM3pXYVFtWms4aHpzQ1AxVkFMWWt1V2d3M0V4bU1UM3d3ZkJYN3lRZWMK",
      "endpoints": [
        "https://github.com/Smith-106/niko-buddy/releases/latest/download/latest.json"
      ]
    }
  }
}
