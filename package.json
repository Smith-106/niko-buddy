{
  "name": "niko-buddy",
  "private": true,
  "version": "2.7.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --build --pretty",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "npm run test:mocks && npm run test:llm && npm run test:cargo",
    "test:mocks": "node scripts/lint-character-aura.mjs && vitest run --exclude='**/*.real-llm.test.ts' --exclude='**/*.real-llm.spec.ts' --exclude='**/*.bench.ts' --exclude='**/.worktrees/**' --exclude='**/.codex-temp/**' --exclude='**/superpowers-main/**' --exclude='**/SKILL/**' --exclude='**/superpowers/**' --exclude='**/nul'",
    "lint:character-aura": "node scripts/lint-character-aura.mjs",
    "test:llm": "vitest run real-llm --no-file-parallelism --reporter=verbose",
    "test:cargo": "cargo test --manifest-path src-tauri/Cargo.toml --quiet",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:CARGO_PROFILE_RELEASE_LTO='false'; $env:CARGO_PROFILE_RELEASE_CODEGEN_UNITS='16'; $env:CARGO_PROFILE_RELEASE_OPT_LEVEL='1'; npx tauri build --no-bundle; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; node scripts/build-portable.mjs\"",
    "build:github-release": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (-not $env:TAURI_SIGNING_PRIVATE_KEY_PATH) { $env:TAURI_SIGNING_PRIVATE_KEY_PATH = Join-Path $env:USERPROFILE '\\.tauri\\qmai-updater.key' }; if (-not (Test-Path $env:TAURI_SIGNING_PRIVATE_KEY_PATH)) { throw '缺少 TAURI_SIGNING_PRIVATE_KEY_PATH 对应的签名私钥文件' }; if ($null -eq $env:TAURI_SIGNING_PRIVATE_KEY_PASSWORD) { $env:TAURI_SIGNING_PRIVATE_KEY_PASSWORD = '' }; $env:CARGO_PROFILE_RELEASE_LTO='false'; $env:CARGO_PROFILE_RELEASE_CODEGEN_UNITS='16'; $env:CARGO_PROFILE_RELEASE_OPT_LEVEL='1'; npx tauri build; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; node scripts/build-portable.mjs; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; node scripts/prepare-github-release.mjs\"",
    "bench": "vitest run bench --reporter=verbose",
    "bench:llm": "cross-env REAL_LLM=1 vitest run src/lib/novel/llm-latency.bench.ts",
    "eval:baseline": "node scripts/eval-baseline.mjs",
    "eval:l3": "cross-env REAL_LLM=1 vitest run src/lib/novel/eval/eval-harness.real-llm.test.ts --no-file-parallelism --reporter=verbose",
    "bench:startup": "vitest run src/test-helpers/startup.bench.ts",
    "test:coverage": "vitest run --exclude=\"**/*.real-llm.test.ts\" --exclude=\"**/*.real-llm.spec.ts\" --exclude=\"**/*.bench.ts\" --exclude=\"**/.worktrees/**\" --exclude=\"**/.codex-temp/**\" --exclude=\"**/superpowers-main/**\" --exclude=\"**/SKILL/**\" --exclude=\"**/superpowers/**\" --exclude=\"**/nul\" --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@milkdown/kit": "^7.20.0",
    "@milkdown/plugin-math": "^7.5.9",
    "@milkdown/react": "^7.20.0",
    "@milkdown/theme-nord": "^7.20.0",
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@react-sigma/core": "^5.0.6",
    "@sigma/edge-curve": "^3.1.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.6",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "^2.9.1",
    "@types/js-yaml": "^4.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "i18next": "^26.0.3",
    "js-yaml": "^4.1.1",
    "jsonrepair": "^3.15.0",
    "katex": "^0.16.45",
    "lucide-react": "^1.7.0",
    "mermaid": "^11.14.0",
    "monaco-editor": "^0.52.0",
    "pangu": "^9.1.0",
    "pinyin-pro": "^3.28.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.2",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.9.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.1.2",
    "sigma": "^3.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^25.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.7.0",
    "fast-diff": "^1.3.0",
    "globals": "^17.11.0",
    "graphology-types": "^0.24.8",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^7.18.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.4"
  }
}
